<fragment>
    <!--
        CP token exchange: swaps the consumer's validated external token for a CP token, so a backend
        behind the CP oauth gateway accepts the call. APIM signs in to the CP tenant as the consumer's
        CP-access app, using its user-assigned identity as a federated credential (no secret).

        Include it in an API's inbound policy after validate-jwt:

            <set-variable name="cpAudience" value="<CP publisher app client ID>" />
            <set-variable name="cpAppId" value="<consumer's CP-access app client ID>" />   (from the API's client map)
            <set-variable name="cpRejectUnmapped" value="@(true)" />   (optional, default false)
            <cache-lookup-value key="cp-token-<cpAppId>-<cpAudience>" variable-name="cpToken" />   (when cpAppId is set)
            <include-fragment fragment-id="cp-token-exchange" />
            <cache-store-value key="cp-token-<cpAppId>-<cpAudience>" value="cpToken" duration="cpTokenCacheSeconds" />
                                                                         (when cpTokenCacheSeconds is set)

        The cache policies stay in the API: cache-lookup-value is not supported inside a policy fragment.
        The fragment skips the CP call when cpToken is already set, and sets cpTokenCacheSeconds after a new token.

        cpAudience     The CP API's publisher app; the token is requested for "<cpAudience>/.default".
        cpAppId        The calling consumer's CP-access app. Each API maps its own consumers (azp => app).
        cpRejectUnmapped
                       true: a consumer with no cpAppId gets 403. false: its request is forwarded
                       unchanged, with the external token.
    -->
    <choose>
        <when condition="@(string.IsNullOrEmpty(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;cpAudience&quot;, &quot;&quot;)))">
            <return-response>
                <set-status code="500" reason="Internal Server Error" />
                <set-header name="Content-Type" exists-action="override">
                    <value>application/json</value>
                </set-header>
                <set-body>{"error":"CP token exchange is not configured for this API."}</set-body>
            </return-response>
        </when>
    </choose>
    <!-- The caller is the external token's azp. validate-jwt has already checked the token. -->
    <set-variable name="extAzp" value="@{
        var auth = context.Request.Headers.GetValueOrDefault(&quot;Authorization&quot;, &quot;&quot;);
        var jwt = auth.StartsWith(&quot;Bearer &quot;) ? auth.Substring(7).AsJwt() : null;
        return jwt == null ? &quot;&quot; : jwt.Claims.GetValueOrDefault(&quot;azp&quot;, &quot;&quot;);
    }" />
    <!-- The calling API maps the consumer to its CP-access app; empty when the consumer is not mapped. -->
    <set-variable name="cpAppId" value="@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;cpAppId&quot;, &quot;&quot;))" />
    <choose>
        <when condition="@(string.IsNullOrEmpty((string)context.Variables[&quot;cpAppId&quot;]) &amp;&amp; context.Variables.GetValueOrDefault&lt;bool&gt;(&quot;cpRejectUnmapped&quot;, false))">
            <return-response>
                <set-status code="403" reason="Forbidden" />
                <set-header name="Content-Type" exists-action="override">
                    <value>application/json</value>
                </set-header>
                <set-body>{"error":"This client is not enabled for this API."}</set-body>
            </return-response>
        </when>
    </choose>
    <choose>
        <when condition="@(!string.IsNullOrEmpty((string)context.Variables[&quot;cpAppId&quot;]))">
            <!-- The calling API looks up the cached CP token first: cache-lookup-value is not supported in a fragment. -->
            <choose>
                <when condition="@(!context.Variables.ContainsKey(&quot;cpToken&quot;))">
                    <!-- APIM's user-assigned identity token is the client assertion: no secret is stored. -->
                    <authentication-managed-identity resource="api://AzureADTokenExchange" client-id="${identity_client_id}" output-token-variable-name="miAssertion" ignore-error="false" />
                    <send-request mode="new" response-variable-name="cpTokenResponse" timeout="10" ignore-error="true">
                        <set-url>https://login.microsoftonline.com/${cp_tenant_id}/oauth2/v2.0/token</set-url>
                        <set-method>POST</set-method>
                        <set-header name="Content-Type" exists-action="override">
                            <value>application/x-www-form-urlencoded</value>
                        </set-header>
                        <set-body>@("grant_type=client_credentials"
                            + "&amp;client_id=" + (string)context.Variables["cpAppId"]
                            + "&amp;scope=" + Uri.EscapeDataString((string)context.Variables["cpAudience"] + "/.default")
                            + "&amp;client_assertion_type=" + Uri.EscapeDataString("urn:ietf:params:oauth:client-assertion-type:jwt-bearer")
                            + "&amp;client_assertion=" + (string)context.Variables["miAssertion"])</set-body>
                    </send-request>
                    <choose>
                        <!-- No answer from CP Entra, or a server error. -->
                        <when condition="@(context.Variables[&quot;cpTokenResponse&quot;] == null || ((IResponse)context.Variables[&quot;cpTokenResponse&quot;]).StatusCode &gt;= 500)">
                            <return-response>
                                <set-status code="502" reason="Bad Gateway" />
                                <set-header name="Content-Type" exists-action="override">
                                    <value>application/json</value>
                                </set-header>
                                <set-body>{"error":"Could not get a token from CP."}</set-body>
                            </return-response>
                        </when>
                        <!-- Entra throttled APIM: temporary, so tell the consumer to retry rather than reporting a permission failure. -->
                        <when condition="@(((IResponse)context.Variables[&quot;cpTokenResponse&quot;]).StatusCode == 429)">
                            <return-response>
                                <set-status code="503" reason="Service Unavailable" />
                                <set-header name="Retry-After" exists-action="override">
                                    <value>@(((IResponse)context.Variables[&quot;cpTokenResponse&quot;]).Headers.GetValueOrDefault(&quot;Retry-After&quot;, &quot;60&quot;))</value>
                                </set-header>
                                <set-header name="Content-Type" exists-action="override">
                                    <value>application/json</value>
                                </set-header>
                                <set-body>{"error":"CP token service is busy. Retry later."}</set-body>
                            </return-response>
                        </when>
                        <!-- CP refused, for example AADSTS501051 when the CP-access app has no role. -->
                        <when condition="@(((IResponse)context.Variables[&quot;cpTokenResponse&quot;]).StatusCode != 200)">
                            <return-response>
                                <set-status code="403" reason="Forbidden" />
                                <set-header name="Content-Type" exists-action="override">
                                    <value>application/json</value>
                                </set-header>
                                <set-body>{"error":"CP has not granted this client access to this API."}</set-body>
                            </return-response>
                        </when>
                    </choose>
                    <set-variable name="cpTokenBody" value="@(((IResponse)context.Variables[&quot;cpTokenResponse&quot;]).Body.As&lt;JObject&gt;())" />
                    <set-variable name="cpToken" value="@((string)((JObject)context.Variables[&quot;cpTokenBody&quot;])[&quot;access_token&quot;])" />
                    <!-- The calling API caches cpToken for this many seconds (cache-store-value stays out of the fragment too). -->
                    <set-variable name="cpTokenCacheSeconds" value="@(Math.Max(60, (int)((JObject)context.Variables[&quot;cpTokenBody&quot;])[&quot;expires_in&quot;] - ${cache_buffer_seconds}))" />
                </when>
            </choose>
            <set-header name="Authorization" exists-action="override">
                <value>@("Bearer " + (string)context.Variables["cpToken"])</value>
            </set-header>
        </when>
    </choose>
    <!-- For logs only: the backend identifies the caller from the CP token's azp. -->
    <set-header name="X-Client-Id" exists-action="override">
        <value>@((string)context.Variables["extAzp"])</value>
    </set-header>
</fragment>
